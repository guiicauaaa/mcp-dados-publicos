<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform (enabled in global.json): the test project is an executable. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <RootNamespace>PublicData.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exe reference: the server DLL, deps.json and runtimeconfig.json land in the test bin, so the
         integration tests start the real server process over stdio and HTTP. -->
    <ProjectReference Include="..\..\src\PublicData.McpServer\PublicData.McpServer.csproj" />
    <ProjectReference Include="..\..\src\PublicData.Chat.Core\PublicData.Chat.Core.csproj" />
    <ProjectReference Include="..\..\src\PublicData.Api\PublicData.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
